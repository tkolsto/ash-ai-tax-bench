# bench.env — pinned pilot configuration. Source before running.
export EFFORT=high            # reasoning effort, IDENTICAL across all runs (medium|high)
export N=3                    # runs per (agent × framework) cell
export CLAUDE_MODEL=claude-opus-4-7   # pin + record
export CODEX_MODEL=gpt-5.5             # gpt-5-codex 400s on ChatGPT accounts; gpt-5.5 confirmed
export BENCH_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
